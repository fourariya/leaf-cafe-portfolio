# Netlify HTTP response headers (https://docs.netlify.com/routing/headers/).
# Copied into dist/ by `npm run build`. The CSP matches the <meta> CSP in index.html,
# plus frame-ancestors, which only works as a real header.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'none'; form-action 'none'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
